generator client {
  provider = "prisma-client"
  output = "../generated/client"
  engineType = "client"
  runtime = "workerd"
}

generator seedClient {
  provider   = "prisma-client"
  output     = "../generated/node-client"
  engineType = "client"
  runtime    = "nodejs"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum RequestStatus {
  NEW
  REVIEWING
  QUOTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
